HOOKLINE_APP_NAME=Hookline
HOOKLINE_LOG_LEVEL=INFO
HOOKLINE_DATABASE_URL=postgresql+psycopg://hookline:change-me@127.0.0.1:5432/hookline
HOOKLINE_JWT_SECRET=change-me
HOOKLINE_ACCESS_TOKEN_MINUTES=15
HOOKLINE_REFRESH_TOKEN_DAYS=7
HOOKLINE_REQUIRE_HTTPS_TARGETS=false
HOOKLINE_ALLOW_PRIVATE_TARGETS=true
HOOKLINE_MAX_BODY_BYTES=262144
HOOKLINE_MAX_PAYLOAD_BYTES=65536
HOOKLINE_DELIVERY_TIMEOUT_SECONDS=10
HOOKLINE_MAX_ATTEMPTS=8
HOOKLINE_BACKOFF_BASE_SECONDS=10
HOOKLINE_BACKOFF_MAX_SECONDS=3600
HOOKLINE_WORKER_BATCH_SIZE=10
HOOKLINE_WORKER_POLL_SECONDS=2
HOOKLINE_WORKER_LEASE_SECONDS=60
HOOKLINE_RATE_LIMIT_PER_MINUTE=120
POSTGRES_USER=hookline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hookline
RECEIVER_SECRET=
