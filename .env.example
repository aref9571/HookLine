HOOKLINE_APP_NAME=Hookline
HOOKLINE_LOG_LEVEL=INFO
HOOKLINE_DATABASE_URL=postgresql+psycopg://hookline:change-me@127.0.0.1:5432/hookline
HOOKLINE_JWT_SECRET=change-me
HOOKLINE_ACCESS_TOKEN_MINUTES=15
HOOKLINE_REFRESH_TOKEN_DAYS=7
HOOKLINE_REQUIRE_HTTPS_TARGETS=true
HOOKLINE_ALLOW_PRIVATE_TARGETS=false
HOOKLINE_MAX_BODY_BYTES=262144
HOOKLINE_MAX_PAYLOAD_BYTES=65536
POSTGRES_USER=hookline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hookline
